    static class Color {
        static final int WHITE = -1;
        static int argb(int a,int r,int g,int b) { return (a<<24)|(r<<16)|(g<<8)|b; }
        static int rgb(int r,int g,int b) { return argb(255,r,g,b); }
        static int red(int c) { return (c>>16)&255; } static int green(int c) { return (c>>8)&255; }
        static int blue(int c) { return c&255; }
        static int HSVToColor(float[] hsv) { return 0xffdd4488; }
