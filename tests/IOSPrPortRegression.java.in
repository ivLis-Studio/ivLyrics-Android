/** Production declarations, synthetic views/animator/clock. No Android raster or device assertions. */
public final class IOSPrPortRegression {
    static int checks;
    static void check(boolean value, String message) {
        checks++;
        if (!value) throw new AssertionError(message);
    }
    static Object field(Object instance, String name) throws Exception {
        Field field = instance.getClass().getDeclaredField(name);
        field.setAccessible(true);
        return field.get(instance);
    }
    static TrackSnapshot track(String id, String album, boolean automix, boolean known, long position) {
        return new TrackSnapshot("Song", "Artist", album, "com.spotify.music", "spotify:track:" + id,
                "", 60_000, position, SystemClock.now, 1f, false, null, "", automix, known, 300, 1300, 0);
    }

    static void rules() throws Exception {
        Field unsafeField = sun.misc.Unsafe.class.getDeclaredField("theUnsafe");
        unsafeField.setAccessible(true);
        sun.misc.Unsafe unsafe = (sun.misc.Unsafe) unsafeField.get(null);
        // Only invoke the production rule parser/cache; no Context, keystore or credentials are created.
        AiLyricsSettings settings = (AiLyricsSettings) unsafe.allocateInstance(AiLyricsSettings.class);
        Map<String, Object> values = new HashMap<>();
        SharedPreferences prefs = (SharedPreferences) Proxy.newProxyInstance(
                SharedPreferences.class.getClassLoader(), new Class<?>[]{SharedPreferences.class},
                (proxy, method, args) -> {
                    if (method.getName().equals("getString") || method.getName().equals("getBoolean"))
                        return values.getOrDefault((String) args[0], args[1]);
                    throw new AssertionError("Unexpected preference operation: " + method.getName());
                });
        Field prefsField = AiLyricsSettings.class.getDeclaredField("prefs");
        prefsField.setAccessible(true);
        prefsField.set(settings, prefs);
        Method load = AiLyricsSettings.class.getDeclaredMethod("loadRuleConfig");
        load.setAccessible(true);
        Object initial = load.invoke(settings);
        for (int i = 0; i < 100; i++) {
            values.put("pip_lyrics_size_percent", i);
            check(load.invoke(settings) == initial, "Unrelated settings must reuse parsed rules");
        }
        values.put("translation_enabled", true);
        Object translation = load.invoke(settings);
        check(translation != initial, "Legacy translation changes invalidate rules");
        check(((AiLyricsSettings.LanguageRule) field(translation, "defaultRule")).translationEnabled,
                "Legacy translation value preserved");
        values.put("pronunciation_enabled", true);
        Object pronunciation = load.invoke(settings);
        check(pronunciation != translation, "Legacy pronunciation changes invalidate rules");
        values.put("target_lang", "default=ko;ja=en");
        Object target = load.invoke(settings);
        check(target != pronunciation, "Legacy target changes invalidate rules");
        check(((AiLyricsSettings.LanguageRule) field(target, "defaultRule")).targetLang.equals("ko"),
                "Legacy target syntax preserved");
        String json = "{\"default\":{\"translation\":false,\"target\":\"ja\"},"
                + "\"rules\":{\"ko\":{\"translation\":true,\"pronunciation\":false,\"target\":\"en\"}}}";
        values.put("language_rules_v2", json);
        Object parsed = load.invoke(settings);
        Map<?, ?> languageRules = (Map<?, ?>) field(parsed, "languageRules");
        check(((AiLyricsSettings.LanguageRule) languageRules.get("ko")).targetLang.equals("en"),
                "Stored per-language rules survive caching");
        Method withTarget = parsed.getClass().getDeclaredMethod("withTarget", String.class);
        withTarget.setAccessible(true);
        Object output = withTarget.invoke(parsed, "ko");
        check(((AiLyricsSettings.LanguageRule) field(output, "defaultRule")).targetLang.equals("ko"),
                "Output language applied separately");
        check(((AiLyricsSettings.LanguageRule) field(parsed, "defaultRule")).targetLang.equals("ja"),
                "Output language does not mutate cached source rules");
        values.put("language_rules_v2", "{malformed");
        Object malformed = load.invoke(settings);
        check(malformed != parsed && load.invoke(settings) == malformed, "Malformed rules cache legacy fallback");
        values.clear();
        Object reset = load.invoke(settings);
        check(!((AiLyricsSettings.LanguageRule) field(reset, "defaultRule")).translationEnabled,
                "Removed preferences restore defaults");
        System.out.println("Parsed language rules: reuse, legacy inputs, replacement, output language and malformed/reset passed");
    }

