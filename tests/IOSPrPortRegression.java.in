    static class AnnotationRenderer {
        List<CulturalAnnotation> culturalAnnotations = Collections.emptyList();
        Map<Integer, LineRenderInput> lineRenderInputs = new HashMap<>();
        Map<String, Object> rowLayoutCache = new HashMap<>();
        String culturalAnnotationFontFamily = AiLyricsSettings.CULTURAL_FONT_PRETENDARD;
        int culturalAnnotationFontSize = 14, culturalAnnotationFontWeight = 300, culturalAnnotationOpacity = 60;
        void invalidateFrameGroupCache() {} void requestLayout() {} void postInvalidateOnAnimation() {}
        // ANNOTATIONS
    }
    static void annotations() {
        AnnotationRenderer view = new AnnotationRenderer();
        List<LyricsLine.Syllable> syllables = List.of(
                new LyricsLine.Syllable("달빛", 1000, 3000, true, true, "glow", "a", "#ffffff", ""));
        LyricsLine line = new LyricsLine(1000, 3000, "달빛 아래", syllables);
        CulturalAnnotation note = new CulturalAnnotation(0, "달빛", "moonlight");
        view.setCulturalAnnotations(List.of(note), "pretendard", 14, 300, 60);
        var input = view.lineRenderInput(line, 0);
        for (int frame = 0; frame < 100; frame++)
            check(view.lineRenderInput(line, 0) == input, "Stable frames reuse prepared annotations");
        check(input.annotations.equals(CulturalAnnotation.forLine(List.of(note), 0, line.text)),
                "Prepared annotation matching equals original lookup");
        view.setCulturalAnnotations(List.of(note), "pretendard", 14, 300, 60);
        check(view.lineRenderInput(line, 0) == input, "Equivalent annotation updates keep the cache");
        CulturalAnnotation next = new CulturalAnnotation(0, "아래", "underneath");
        view.setCulturalAnnotations(List.of(next), "pretendard", 14, 300, 60);
        check(view.lineRenderInput(line, 0).annotations.equals(List.of(next)), "New annotations invalidate inputs");
        LyricsLine replacement = new LyricsLine(1000, 5000, "아래의 별", syllables);
        check(view.lineRenderInput(replacement, 0).line == replacement, "Same-index replacement uses new line");
        check(line.syllables == syllables || line.syllables.get(0) == syllables.get(0), "Source timing is not changed");
        view.setCulturalAnnotations(Collections.emptyList(), "pretendard", 14, 300, 60);
        check(view.lineRenderInput(line, 0).annotations.isEmpty(), "Disabling annotations clears matches");
        LyricsLine.VocalPart lead = new LyricsLine.VocalPart("a", "lead", "a", "vocal", "달빛", syllables);
        LyricsLine.VocalPart backing = new LyricsLine.VocalPart("b", "background", "b", "vocal", "아래", syllables);
        LyricsLine duet = new LyricsLine(1000, 3000, "", List.of(), "", "vocal", List.of(lead, backing));
        view.setCulturalAnnotations(List.of(note, next), "pretendard", 14, 300, 60);
        var duetInput = view.lineRenderInput(duet, 0);
        check(duetInput.displayText.equals("달빛 / 아래") && duetInput.annotations.equals(List.of(note, next)),
                "Vocal-only lines retain combined text and annotation order");
        System.out.println("Line render inputs: reuse, annotation updates, replacement, disabled and vocal-only rows passed");
    }

